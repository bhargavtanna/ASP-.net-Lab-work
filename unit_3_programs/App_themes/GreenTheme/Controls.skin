<%-- Default Skin --%>
<asp:Label runat="server" Font-Names="Courier New" Font-Size="14px" ForeColor="#1e7e34" />

<%-- Named Skin --%>
<asp:Label runat="server" SkinID="HeaderLabel" Font-Names="Courier New" Font-Size="24px" Font-Bold="true" ForeColor="#0b511b" />

<%-- Default Button Skin --%>
<asp:Button runat="server" BackColor="#28a745" ForeColor="White" BorderWidth="1px" BorderColor="#1e7e34" Height="35px" Width="150px" />
